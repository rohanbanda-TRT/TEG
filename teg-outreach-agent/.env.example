DATABASE_URL=postgresql+psycopg://teg@127.0.0.1:5433/teg_outreach
LLM_PROVIDER=gemini
LLM_MODEL_FAST=gemini-flash-latest
LLM_MODEL_MAIN=gemini-flash-latest
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
RESEARCH_MAX_SEARCHES_PER_TRACK=2
RESEARCH_MAX_SCRAPES=3
PIPELINE_SOFT_TIMEOUT_S=15
PIPELINE_HARD_TIMEOUT_S=90
KB_PATH=../teg-kb-agent/knowledge_base
DATA_RETENTION_DAYS=180
LINKEDIN_PROVIDER=none
PROPOSAL_MODEL=
PROPOSAL_SOFT_TIMEOUT_S=15
PROPOSAL_HARD_TIMEOUT_S=90
PROPOSAL_DIR=./proposals
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- claude CLI backend (skills-as-prompt-assets) ---
# true -> ProposalAgent generates via the `claude` CLI instead of the LLM client.
# Needs `claude` on PATH and logged in (`claude auth login`), or ANTHROPIC_API_KEY.
# Anthropic requires API-key auth for third-party products in production.
CLAUDE_CLI_ENABLED=false
CLAUDE_CLI_MODEL=claude-sonnet-5
CLAUDE_CLI_TIMEOUT_S=180
SKILLS_PATH=./skills

# With CLAUDE_CLI_ENABLED=true, research uses Claude's own WebSearch/WebFetch
# and TAVILY_API_KEY / the page scraper are no longer used.
