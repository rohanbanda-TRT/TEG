# Database Configuration
DATABASE_URL=postgresql+psycopg://teg:teg@localhost:5432/teg_outreach

# LLM Provider Configuration (choose one: anthropic, nvidia, gemini)
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_MAIN=claude-sonnet-5

# Anthropic API Key
ANTHROPIC_API_KEY=

# NVIDIA API Key
NVIDIA_API_KEY=

# Gemini API Key
GEMINI_API_KEY=

# Web Search Provider Configuration (choose one: tavily, brave, firecrawl, google_serp)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_SERP_API_KEY=

# Research Limits
RESEARCH_MAX_SEARCHES_PER_TRACK=2
RESEARCH_MAX_SCRAPES=3

# Pipeline Timeouts (seconds)
PIPELINE_SOFT_TIMEOUT_S=8
PIPELINE_HARD_TIMEOUT_S=20

# Knowledge Base Path (relative to this directory)
KB_PATH=../teg-kb-agent/knowledge_base

# Data Retention (days)
DATA_RETENTION_DAYS=180

# LinkedIn Provider (only "none" is supported - no paid LinkedIn)
LINKEDIN_PROVIDER=none
